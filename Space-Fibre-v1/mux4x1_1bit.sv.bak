module mux4x1_1bit (
    input  logic I0,
    input  logic I1,
    input  logic I2,
    input  logic I3,
    input  logic S1,
    input  logic S0,
    output logic Y
);

    always_comb begin
        case ({S1, S0})
            2'b00: Y = I0;
            2'b01: Y = I1;
            2'b10: Y = I2;
            2'b11: Y = I3;
            default: Y = 1'b0;
        endcase
    end

endmodule